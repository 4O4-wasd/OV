        "argon2": "^0.45.1",
        "better-auth": "^1.7.9",
        "dotenv": "^18.0.6",
        "drizzle-orm": "1.0.0-rc.4",
        "hono": "^4.13.13",
        "react": "^19.3.0",
        "react-email": "^6.11.1",
        "resend": "^6.32.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@hono/node-server": "^2.1.4",
        "@react-email/ui": "6.11.1",
        "@types/node": "^24.0.0",
