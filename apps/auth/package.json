    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "dev:vercel": "vercel dev",
        "start": "node dist/server.js",
        "check": "tsc --noEmit",
        "email:dev": "email dev --dir src/mail/templates",
        "auth:generate": "pnpm dlx auth@latest generate --config src/auth.ts --output src/shared/db/schema.ts -y",
