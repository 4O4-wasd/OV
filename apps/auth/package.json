        "db:push": "drizzle-kit push",
        "build": "tsc",
        "openapi": "tsx scripts/generate-openapi.ts"
    },
    "dependencies": {
        "@better-auth/drizzle-adapter": "^1.7.9",
        "@libsql/client": "^0.18.0",
